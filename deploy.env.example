# FTP の接続情報（このファイルをコピーして deploy.env を作り、値を入れる）
#   cp deploy.env.example deploy.env && chmod 600 deploy.env
# ★deploy.env は git に入れない（.gitignore 済み）
FTP_HOST=
FTP_USER=
FTP_PASS=
# 公開フォルダ（サーバー上でトップページ index.html を置く場所。例: /public_html や /uminaibi-resin.jp/public_html）
FTP_DIR=
# 暗号化（FTPS）を使うなら yes。サーバーが対応していなければ no
FTP_TLS=yes
