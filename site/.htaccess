# http:// で来たら https:// へ転送する（2026-10-26）
#   ★サーバー（heteml）の前で暗号化が外される場合にも転送が繰り返されないよう、X-Forwarded-Proto も見る
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# メール・Stripe のログイン情報・ひな形は外から開けない
<FilesMatch "^(mail|stripe)-config(\.example)?\.php$">
  Require all denied
</FilesMatch>

# ===== セキュリティ対策（2026-10-26）=====
# フォルダの中身の一覧を出さない
Options -Indexes

# 隠しファイル（.htaccess・.git など）と、控え・設定のファイルは外から開けない
<FilesMatch "(^\.|\.(bak|old|orig|swp|sql|log|ini|env|md|sh|zip|tar|gz)$|~$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # https だけで開くようにブラウザに覚えさせる（1年）
  Header always set Strict-Transport-Security "max-age=31536000"
  # ファイルの種類を勝手に推測させない
  Header always set X-Content-Type-Options "nosniff"
  # 他のサイトの枠の中に表示させない（なりすまし画面の防止）
  Header always set X-Frame-Options "SAMEORIGIN"
  # 他のサイトへ移るとき、送る情報を最小限に
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # カメラ・マイク・位置情報などは使わない
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # 読み込んでよい先を決める（Tailwind・Google フォント・Google マップだけ許す）。購入ボタンの移動先に Stripe の決済ページを許す
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://www.google.com https://maps.google.com; connect-src 'self'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>
